---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/site/PageHeader.astro';
import WaveFooter from '../../components/ui/WaveFooter.astro';
import BackToTools from '../../components/ui/BackToTools.astro';
import EnrichTool from '../../components/tools/enrich/EnrichTool';
---

<BaseLayout
  title="Enrich | VitaeFlow"
  description="Upload a plain PDF resume, fill in structured data, and download an enriched .vf.pdf file."
>
  <PageHeader
    title="Enrich"
    description="Upload your resume PDF, fill in structured data through a guided form, and download an enriched .vf.pdf — machine-readable and human-friendly."
    activePath="/tools/"
  />

  <main class="relative z-1 mx-auto w-[min(calc(100%-2rem),1260px)] py-12">
    <BackToTools />
    <EnrichTool client:load />
  </main>

  <WaveFooter />
</BaseLayout>
