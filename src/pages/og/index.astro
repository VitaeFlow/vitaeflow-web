---
// This page is only used to screenshot OG images (1200x630).
// Open it in a browser at exactly 1200x630 and take a screenshot.
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=1200" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@600;800&display=swap" rel="stylesheet" />
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }

      body {
        width: 1200px;
        height: 630px;
        font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        background:
          radial-gradient(circle at 20% 30%, rgba(111, 157, 158, 0.15), transparent 50%),
          radial-gradient(circle at 80% 70%, rgba(59, 96, 107, 0.1), transparent 50%),
          linear-gradient(160deg, #24374a 0%, #1b3347 40%, #24374a 100%);
        position: relative;
      }

      .content {
        position: relative;
        z-index: 2;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        gap: 24px;
      }

      .logo {
        display: flex;
        align-items: center;
        gap: 18px;
      }

      .logo-text {
        font-size: 72px;
        font-weight: 800;
        color: #fffdf8;
        letter-spacing: -3px;
      }

      .logo-text span {
        color: #6f9d9e;
      }

      .tagline {
        font-size: 32px;
        font-weight: 600;
        color: rgba(255, 253, 248, 0.85);
        letter-spacing: -0.5px;
      }

      .subtitle {
        font-size: 20px;
        font-weight: 600;
        color: rgba(255, 253, 248, 0.5);
        max-width: 700px;
        line-height: 1.5;
      }

      .badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(111, 157, 158, 0.15);
        border: 1px solid rgba(111, 157, 158, 0.25);
        border-radius: 100px;
        padding: 10px 24px;
        font-size: 16px;
        font-weight: 600;
        color: #6f9d9e;
        letter-spacing: 0.5px;
      }

      .url {
        position: absolute;
        bottom: 40px;
        right: 50px;
        font-size: 22px;
        font-weight: 600;
        color: rgba(255, 253, 248, 0.35);
        letter-spacing: -0.3px;
      }

      /* Decorative shapes */
      .shape {
        position: absolute;
        z-index: 1;
        opacity: 0.06;
      }

      .shape-1 {
        top: -60px;
        right: -40px;
        width: 300px;
        height: 300px;
        border-radius: 50%;
        background: #6f9d9e;
      }

      .shape-2 {
        bottom: -80px;
        left: -60px;
        width: 250px;
        height: 250px;
        border-radius: 50%;
        background: #6f9d9e;
      }

      .shape-3 {
        top: 50%;
        left: 10%;
        width: 2px;
        height: 120px;
        background: linear-gradient(to bottom, transparent, rgba(111, 157, 158, 0.3), transparent);
      }

      .shape-4 {
        top: 30%;
        right: 12%;
        width: 2px;
        height: 80px;
        background: linear-gradient(to bottom, transparent, rgba(111, 157, 158, 0.2), transparent);
      }
    </style>
  </head>
  <body>
    <div class="shape shape-1"></div>
    <div class="shape shape-2"></div>
    <div class="shape shape-3"></div>
    <div class="shape shape-4"></div>

    <div class="content">
      <div class="badge">Open Standard &middot; MIT Licensed</div>

      <div class="logo">
        <svg width="52" height="56" viewBox="0 0 22 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <polygon points="11,0 22,6 22,18 11,24 0,18 0,6" fill="#4e7983" />
          <polygon points="11,0 22,6 11,12 0,6" fill="#6d989d" />
          <polygon points="0,6 11,12 11,24 0,18" fill="#3e636b" />
        </svg>
        <span class="logo-text">Vitae<span>Flow</span></span>
      </div>

      <div class="tagline">Your resume, enhanced.</div>

      <div class="subtitle">
        An open standard for embedding structured JSON data inside PDF resumes.
      </div>
    </div>

    <div class="url">vitaeflow.org</div>
  </body>
</html>
