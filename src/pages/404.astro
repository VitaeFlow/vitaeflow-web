---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/site/SiteHeader.astro';
import WaveTransition from '../components/ui/WaveTransition.astro';
---

<BaseLayout title="Page not found | VitaeFlow" description="This page does not exist.">

  <!-- Dark zone: header + 404 content + waves -->
  <div class="relative w-full overflow-hidden bg-[radial-gradient(circle_at_60%_-20%,#38576d,#24374a)] pb-32 text-white-soft">
    <SiteHeader variant="transparent" />

    <main class="relative z-10 mx-auto flex min-h-[50vh] max-w-[1260px] flex-col items-center justify-center px-4 py-20 text-center">
      <span class="inline-flex rounded-full border border-white/15 bg-white/8 px-4 py-1.5 text-[0.8rem] font-bold tracking-[0.2em] text-teal-muted">
        404
      </span>

      <h1 class="mt-6 text-[clamp(2.8rem,8vw,5rem)] font-extrabold leading-[0.92] tracking-tighter">
        Page not found
      </h1>

      <p class="mx-auto mt-5 max-w-[26rem] text-lg leading-relaxed text-white/65">
        This page doesn't exist or has been moved. Let's get you back on track.
      </p>

      <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
        <a
          href="/"
          class="inline-flex min-h-[3.4rem] items-center justify-center gap-3 rounded-full bg-cream-strong px-7 py-2.5 font-bold text-navy shadow-[0_12px_24px_rgba(11,27,38,0.2)] transition-all duration-300 hover:-translate-y-0.5 hover:shadow-[0_16px_32px_rgba(11,27,38,0.28)]"
        >
          Back to home
        </a>
        <a
          href="/tools/"
          class="inline-flex min-h-[3.4rem] items-center justify-center rounded-full border border-white/20 px-7 py-2.5 font-bold text-white/90 transition-all duration-300 hover:-translate-y-0.5 hover:border-white/40 hover:text-white"
        >
          Try the tools
        </a>
      </div>
    </main>

    <WaveTransition />
  </div>
</BaseLayout>
