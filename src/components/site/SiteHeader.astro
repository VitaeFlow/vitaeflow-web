---
import { primaryNav } from '../../data/navigation';

interface Props {
  activePath?: string;
  variant?: 'default' | 'transparent';
}

const { activePath, variant = 'default' } = Astro.props;
const isTransparent = variant === 'transparent';

const navIcons: Record<string, string> = {
  Tools: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>`,
  'Getting Started': `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3"/></svg>`,
  GitHub: `<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>`,
};
---

<div class:list={[
  'w-full',
  isTransparent ? '' : 'bg-[radial-gradient(circle_at_60%_-20%,#38576d,#24374a)]',
]}>
  <header class="relative z-20 border-b border-white/5">
    <div class="mx-auto flex max-w-[1260px] items-center justify-between px-4 py-5 sm:px-8">
      <a
        href="/"
        class="inline-flex items-center gap-3 text-lg font-bold tracking-tight text-white-soft no-underline"
      >
        <svg width="22" height="24" viewBox="0 0 22 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <polygon points="11,0 22,6 22,18 11,24 0,18 0,6" fill="#4e7983" />
          <polygon points="11,0 22,6 11,12 0,6" fill="#6d989d" />
          <polygon points="0,6 11,12 11,24 0,18" fill="#3e636b" />
        </svg>
        VitaeFlow
      </a>

      <!-- Desktop nav -->
      <nav class="hidden items-center gap-3 sm:flex" aria-label="Primary">
        {primaryNav.map((link) => (
          <a
            href={link.href}
            rel={link.external ? 'noreferrer' : undefined}
            target={link.external ? '_blank' : undefined}
            class:list={[
              'rounded-full text-[0.95rem] font-semibold transition-all duration-200',
              link.cta
                ? 'bg-sand px-5 py-2 text-navy shadow-[0_4px_16px_rgba(0,0,0,0.15)] hover:-translate-y-0.5 hover:shadow-[0_6px_20px_rgba(0,0,0,0.2)]'
                : [
                    'px-4 py-2 text-white/90 hover:text-white-soft',
                    activePath === link.href ? 'border-b-2 border-teal-muted text-white-soft' : 'border-b-2 border-transparent',
                  ],
            ]}
          >
            {link.label}
          </a>
        ))}
      </nav>

      <!-- Mobile burger -->
      <button
        class="inline-flex h-10 w-10 items-center justify-center rounded-xl text-white/90 transition-colors hover:bg-white/10 sm:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        data-menu-toggle
      >
        <svg class="h-5 w-5" data-icon="menu" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
          <line x1="3" y1="6" x2="21" y2="6" /><line x1="3" y1="12" x2="21" y2="12" /><line x1="3" y1="18" x2="21" y2="18" />
        </svg>
        <svg class="hidden h-5 w-5" data-icon="close" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
          <line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" />
        </svg>
      </button>
    </div>

    <!-- Mobile menu -->
    <nav
      class="hidden sm:!hidden"
      data-menu-panel
      aria-label="Mobile navigation"
    >
      <div class="mx-4 mb-5 mt-1 flex flex-col gap-1 rounded-2xl border border-white/10 bg-white/5 p-2 backdrop-blur-sm">
        {primaryNav.map((link) => (
          <a
            href={link.href}
            rel={link.external ? 'noreferrer' : undefined}
            target={link.external ? '_blank' : undefined}
            class:list={[
              'flex items-center gap-3 rounded-xl px-4 py-3.5 text-[0.95rem] font-semibold transition-colors',
              link.cta
                ? 'bg-sand text-navy justify-center mt-1'
                : activePath === link.href
                  ? 'bg-white/12 text-white-soft'
                  : 'text-white/75 hover:bg-white/8 hover:text-white-soft',
            ]}
          >
            {!link.cta && (
              <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-white/8 text-white/60">
                <Fragment set:html={navIcons[link.label]} />
              </span>
            )}
            {link.label}
            {link.external && (
              <svg class="ml-auto h-4 w-4 text-white/30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" /><polyline points="15 3 21 3 21 9" /><line x1="10" y1="14" x2="21" y2="3" />
              </svg>
            )}
          </a>
        ))}
      </div>
    </nav>
  </header>
</div>

<script>
  document.querySelectorAll('[data-menu-toggle]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const panel = btn.closest('header')!.querySelector('[data-menu-panel]')!;
      const isOpen = !panel.classList.contains('hidden');

      panel.classList.toggle('hidden', isOpen);
      btn.setAttribute('aria-expanded', String(!isOpen));
      btn.querySelector('[data-icon="menu"]')!.classList.toggle('hidden', !isOpen);
      btn.querySelector('[data-icon="close"]')!.classList.toggle('hidden', isOpen);
    });
  });
</script>
