---
import IsometricCube from '../ui/IsometricCube.astro';

const SHADOW_ANGLE = 15;
const LIGHT_RATIO = 0.8;
---

<!-- CTA -->
<div class="relative z-5 px-6 text-center text-white-soft">
  <h2 class="m-0 text-[clamp(1.8rem,3.5vw,2.85rem)] font-extrabold tracking-tighter">
    Have an idea for a new tool?
  </h2>
  <p class="mx-auto mt-4 mb-9 text-lg text-white/85">
    Contribute your tools to help grow the VitaeFlow ecosystem.
  </p>
  <a
    href="https://github.com/VitaeFlow"
    target="_blank"
    rel="noreferrer"
    class="inline-flex items-center justify-center rounded-full bg-cream-strong px-8 py-3.5 font-bold text-navy shadow-[0_12px_24px_rgba(11,27,38,0.15)] transition-all duration-300 hover:-translate-y-0.5 hover:shadow-[0_16px_32px_rgba(11,27,38,0.22)]"
  >
    Contribute on GitHub
  </a>
</div>

<!-- Isometric cubes scene -->
<div class="pointer-events-none absolute inset-0 z-1 overflow-hidden" aria-hidden="true">
  <svg
    viewBox="0 0 1440 600"
    preserveAspectRatio="xMidYMax slice"
    xmlns="http://www.w3.org/2000/svg"
    class="absolute bottom-0 left-0 w-full"
  >
    <path fill="#e3d7c5" opacity="0.6" d="M0,350 C300,500 600,280 1440,300 L1440,600 L0,600 Z" />
    <path fill="#e1d2be" d="M0,520 C200,480 400,380 900,420 C1100,440 1300,350 1440,360 L1440,600 L0,600 Z" />
    <path fill="#f3ebe1" d="M120,600 C300,550 650,470 1000,470 C1200,470 1350,420 1440,350 L1440,600 Z" />
    <path fill="#6f9d9e" opacity="0.75" d="M0,450 C150,420 350,550 650,600 L0,600 Z" />
    <path fill="#3b606b" opacity="0.9" d="M900,600 C1150,530 1300,530 1440,560 L1440,600 Z" />

    <IsometricCube x={10} y={560} scale={1.6} w={70} d={30} h={80} shadowAngle={SHADOW_ANGLE} shadowLength={80 * LIGHT_RATIO} leftColor="#3e636b" rightColor="#2d4a52" topColor="#6d989d" shadowOpacity={0.2} />
    <IsometricCube x={260} y={484} scale={1.1} w={60} d={30} h={40} shadowAngle={SHADOW_ANGLE} shadowLength={40 * LIGHT_RATIO} leftColor="#4e7983" rightColor="#2d4f59" topColor="#6d989d" shadowColor="#bba689" shadowOpacity={0.4} />
    <IsometricCube x={200} y={538} scale={0.6} w={30} d={15} h={25} shadowAngle={SHADOW_ANGLE} shadowLength={25 * LIGHT_RATIO} leftColor="#efecd6" rightColor="#d1cab5" topColor="#fffdf9" shadowColor="#bba689" shadowOpacity={0.5} />
    <IsometricCube x={430} y={492} scale={0.4} w={30} d={15} h={30} shadowAngle={SHADOW_ANGLE} shadowLength={30 * LIGHT_RATIO} leftColor="#4e7983" rightColor="#3e636b" topColor="#6d989d" shadowColor="#a3937b" shadowOpacity={0.6} />
    <IsometricCube x={860} y={370.5} scale={0.35} w={30} d={15} h={30} shadowAngle={SHADOW_ANGLE} shadowLength={30 * LIGHT_RATIO} leftColor="#4e7983" rightColor="#3e636b" topColor="#6d989d" shadowColor="#bba689" shadowOpacity={0.4} />
    <IsometricCube x={1050} y={464} scale={1.1} w={60} d={30} h={40} shadowAngle={SHADOW_ANGLE} shadowLength={40 * LIGHT_RATIO} leftColor="#4e7983" rightColor="#3e636b" topColor="#6d989d" shadowColor="#a3937b" shadowOpacity={0.5} />
    <IsometricCube x={1250} y={552} scale={1.3} w={60} d={30} h={40} shadowAngle={SHADOW_ANGLE} shadowLength={40 * LIGHT_RATIO} leftColor="#4d7e82" rightColor="#2d4f59" topColor="#6d989d" shadowColor="#a3937b" shadowOpacity={0.5} />
  </svg>
</div>

<!-- Footer bar -->
<footer class="relative z-5 mx-auto mt-40 flex max-w-[1260px] items-center justify-between gap-4 rounded-full border border-white/50 bg-white/35 px-8 py-4 shadow-[0_8px_32px_rgba(36,55,70,0.1)] backdrop-blur-[16px] max-md:flex-col max-md:items-start">
  <div class="flex gap-4">
    <a href="/docs/" class="font-semibold text-navy transition-opacity duration-300 hover:opacity-70">Getting Started</a>
    <a href="https://github.com/VitaeFlow" target="_blank" rel="noreferrer" class="font-semibold text-navy transition-opacity duration-300 hover:opacity-70">GitHub</a>
  </div>
</footer>
