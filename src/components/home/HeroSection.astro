---
import HeroIllustration from './HeroIllustration.astro';
---

<section class="relative overflow-hidden">
  <!-- Background wave -->
  <svg
    class="pointer-events-none absolute top-0 left-1/2 -z-0 h-[calc(100%+6rem)] w-screen -translate-x-1/2"
    preserveAspectRatio="none"
    viewBox="0 0 1200 620"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
  >
    <path d="M0 0 L1200 0 L1200 550 C800 650 400 450 0 570 Z" fill="#fcfbf8" />
    <path d="M0 450 C200 550 450 480 650 350 C800 250 1000 150 1200 250 L1200 550 C800 650 400 450 0 570 Z" fill="#f5e9da" />
  </svg>

  <!-- Hero content -->
  <div class="relative z-1 mx-auto grid w-[min(calc(100%-2rem),1320px)] grid-cols-[minmax(0,1.05fr)_minmax(400px,0.95fr)] gap-6 px-7 pt-14 pb-10 max-lg:grid-cols-1">

    <!-- Copy -->
    <div class="relative z-1 pt-8">
      <span class="mb-8 inline-block rounded-full bg-[#e0eae0] px-5 py-2 text-[0.85rem] font-bold tracking-wide text-teal">
        Open Standard &middot; MIT Licensed
      </span>

      <h1 class="mt-0 leading-[0.95] text-ink">
        <span class="block text-[clamp(3rem,5vw,4.5rem)] font-extrabold tracking-tighter">
          Vitae<span class="text-teal">Flow</span>
        </span>
        <span class="mt-3 block text-[clamp(1.6rem,2.8vw,2.3rem)] font-extrabold tracking-tight">
          Your resume, enhanced.
        </span>
      </h1>

      <p class="mt-6 max-w-[500px] text-[1.12rem] leading-[1.7] text-ink/80">
        An open standard that makes PDF resumes machine-readable without changing how they look. One file for humans and software alike.
      </p>

      <div class="mt-10 flex flex-wrap gap-4 max-sm:flex-col">
        <a
          href="/docs/"
          class="inline-flex min-h-[3.6rem] items-center justify-center gap-3.5 rounded-full bg-linear-to-b from-teal-light to-teal py-2 pr-2 pl-6 font-bold text-white-soft shadow-[0_18px_34px_rgba(84,126,132,0.28)] transition-all duration-300 hover:-translate-y-0.5"
        >
          Read the docs
          <span class="inline-grid h-10 w-10 place-items-center rounded-full bg-white/16 transition-all duration-300">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </span>
        </a>
        <a
          href="/tools/"
          class="inline-flex min-h-[3.6rem] items-center justify-center gap-3.5 rounded-full border border-ink/12 bg-white/72 px-6 py-2 font-bold text-ink transition-all duration-300 hover:-translate-y-0.5"
        >
          Try the tools
        </a>
      </div>
    </div>

    <HeroIllustration />
  </div>
</section>
