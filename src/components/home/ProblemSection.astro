---
import { problemCards } from '../../data/home';
import Card from '../ui/Card.astro';

const iconMap: Record<string, string> = {
  pdf: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>`,
  json: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>`,
  split: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="2" x2="12" y2="22"/><path d="M17 5H9a2 2 0 0 0-2 2v0a2 2 0 0 0 2 2h2a2 2 0 0 1 2 2v0a2 2 0 0 1-2 2H7"/><path d="M7 17h10a2 2 0 0 0 2-2v0a2 2 0 0 0-2-2"/></svg>`,
};
---

<section class="relative mx-auto w-[min(calc(100%-2rem),1260px)] pt-20">
  <div class="max-w-[44rem]">
    <span class="inline-flex rounded-full border border-bg-deep/10 bg-white/45 px-3.5 py-1.5 text-[0.72rem] font-bold uppercase tracking-[0.22em] text-bg-deep">
      The problem
    </span>
    <h2 class="mt-5 text-[clamp(2.05rem,3.15vw,3.15rem)] font-extrabold leading-[0.96] tracking-tighter text-ink text-balance">
      Resumes are stuck between two worlds
    </h2>
    <p class="mt-4 max-w-[38rem] text-lg leading-relaxed text-ink-soft">
      PDFs look great but are unstructured. JSON is structured but invisible. Today, there is no good way to have both in one file.
    </p>
  </div>

  <div class="mt-10 grid grid-cols-3 gap-5 max-lg:grid-cols-1">
    {problemCards.map((card) => (
      <Card>
        <div class="mb-5 flex h-12 w-12 items-center justify-center rounded-xl bg-teal/10 text-teal">
          <Fragment set:html={iconMap[card.icon]} />
        </div>
        <h3 class="text-lg font-bold tracking-tight text-ink">{card.title}</h3>
        <p class="mt-2.5 text-[0.95rem] leading-relaxed text-ink-soft">{card.description}</p>
      </Card>
    ))}
  </div>
</section>
