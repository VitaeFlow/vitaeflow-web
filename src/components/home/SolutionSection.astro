---
import Card from '../ui/Card.astro';
import JsonBlock from '../ui/JsonBlock.astro';
---

<section class="relative mx-auto w-[min(calc(100%-2rem),1260px)] pt-24">
  <div class="max-w-[44rem]">
    <span class="inline-flex rounded-full border border-bg-deep/10 bg-white/45 px-3.5 py-1.5 text-[0.72rem] font-bold uppercase tracking-[0.22em] text-bg-deep">
      How VitaeFlow works
    </span>
    <h2 class="mt-5 text-[clamp(2.05rem,3.15vw,3.15rem)] font-extrabold leading-[0.96] tracking-tighter text-ink text-balance">
      One file, two layers
    </h2>
    <p class="mt-4 max-w-[38rem] text-lg leading-relaxed text-ink-soft">
      VitaeFlow uses the associated files mechanism used by PDF/A-3 to attach a JSON file directly inside your resume PDF. The visual document stays untouched — the data rides along invisibly.
    </p>
  </div>

  <!-- Visual: PDF + JSON = .vf.pdf -->
  <div class="mt-12 grid grid-cols-2 gap-5 max-md:grid-cols-1">

    <!-- PDF layer -->
    <Card hover={false}>
      <div class="mb-4 flex items-center gap-3">
        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-teal/10 text-teal">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z" />
            <polyline points="14 2 14 8 20 8" />
          </svg>
        </div>
        <h3 class="text-lg font-bold text-ink">Visual layer</h3>
      </div>
      <p class="text-[0.92rem] leading-relaxed text-ink-soft">
        Your existing resume PDF. The layout, fonts, and design stay exactly as they are — nothing is modified.
      </p>
      <div class="mt-5 rounded-xl bg-cream/60 p-4">
        <div class="space-y-2.5">
          <div class="h-3 w-2/5 rounded-full bg-navy/20"></div>
          <div class="h-2 w-4/5 rounded-full bg-navy/10"></div>
          <div class="h-2 w-3/5 rounded-full bg-navy/10"></div>
          <div class="mt-4 h-3 w-1/3 rounded-full bg-navy/20"></div>
          <div class="h-2 w-full rounded-full bg-navy/10"></div>
          <div class="h-2 w-4/5 rounded-full bg-navy/10"></div>
          <div class="h-2 w-2/3 rounded-full bg-navy/10"></div>
        </div>
      </div>
    </Card>

    <!-- JSON layer -->
    <Card hover={false}>
      <div class="mb-4 flex items-center gap-3">
        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-teal/10 text-teal">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="16 18 22 12 16 6" />
            <polyline points="8 6 2 12 8 18" />
          </svg>
        </div>
        <h3 class="text-lg font-bold text-ink">Data layer</h3>
      </div>
      <p class="text-[0.92rem] leading-relaxed text-ink-soft">
        A JSON file following the VitaeFlow schema, embedded inside the PDF. Typed, structured, and extractable by any compatible tool.
      </p>
      <JsonBlock class="mt-5" data={{ basics: { givenName: "Marie", familyName: "Dupont", headline: "Software Engineer", email: "marie@example.com" } }} />
    </Card>
  </div>

  <!-- Result -->
  <div class="mx-auto mt-8 flex items-center justify-center gap-4 text-center max-sm:flex-col">
    <div class="h-px w-16 bg-ink/10 max-sm:h-8 max-sm:w-px"></div>
    <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-teal shadow-[0_8px_24px_rgba(86,131,131,0.3)]">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="20 6 9 17 4 12" />
      </svg>
    </div>
    <p class="text-lg font-semibold text-ink">
      One <code class="rounded-lg bg-teal/10 px-2 py-1 text-[0.88rem] font-bold text-teal">.vf.pdf</code> file — opens everywhere, readable by machines.
    </p>
    <div class="h-px w-16 bg-ink/10 max-sm:hidden"></div>
  </div>
</section>
