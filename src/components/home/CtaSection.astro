---
---

<section class="relative mx-auto w-[min(calc(100%-2rem),1260px)] pt-24 pb-20">
  <div class="overflow-hidden rounded-3xl bg-[radial-gradient(circle_at_30%_-20%,#38576d,#24374a)] px-12 py-16 text-center max-sm:px-6 max-sm:py-10">
    <h2 class="text-[clamp(1.8rem,3.5vw,2.6rem)] font-extrabold tracking-tighter text-white-soft">
      Ready to try VitaeFlow?
    </h2>
    <p class="mx-auto mt-4 max-w-[32rem] text-[1.05rem] leading-relaxed text-white/75">
      Enrich your first PDF in minutes, or explore the spec to integrate VitaeFlow into your own tools.
    </p>

    <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
      <a
        href="/tools/"
        class="inline-flex min-h-[3.4rem] items-center justify-center rounded-full bg-cream-strong px-7 py-2.5 font-bold text-navy shadow-[0_12px_24px_rgba(11,27,38,0.2)] transition-all duration-300 hover:-translate-y-0.5 hover:shadow-[0_16px_32px_rgba(11,27,38,0.28)]"
      >
        Try the tools
      </a>
      <a
        href="/docs/"
        class="inline-flex min-h-[3.4rem] items-center justify-center rounded-full border border-white/20 px-7 py-2.5 font-bold text-white/90 transition-all duration-300 hover:-translate-y-0.5 hover:border-white/40 hover:text-white"
      >
        Read the docs
      </a>
      <a
        href="https://github.com/VitaeFlow"
        target="_blank"
        rel="noreferrer"
        class="inline-flex min-h-[3.4rem] items-center justify-center rounded-full border border-white/20 px-7 py-2.5 font-bold text-white/90 transition-all duration-300 hover:-translate-y-0.5 hover:border-white/40 hover:text-white"
      >
        View on GitHub
      </a>
    </div>
  </div>
</section>
