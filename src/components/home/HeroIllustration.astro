<div class="relative z-1 flex min-h-[27rem] items-center justify-center overflow-hidden max-lg:hidden" aria-hidden="true">
  <svg
    width="620"
    height="500"
    viewBox="0 0 720 500"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 h-[115%] w-[115%]"
  >
    <!-- Floating particles -->
    <rect x="60" y="400" width="8" height="8" rx="2" fill="#d9cdb8" transform="rotate(15 60 400)" />
    <rect x="140" y="445" width="10" height="10" rx="2" fill="#24374a" transform="rotate(-10 140 445)" />
    <rect x="545" y="105" width="14" height="14" rx="3" fill="#87b7b7" transform="rotate(25 545 105)" />
    <rect x="510" y="72" width="12" height="12" rx="2" fill="#d9cdb8" transform="rotate(-5 510 72)" />
    <rect x="555" y="52" width="8" height="8" rx="1" fill="#24374a" />
    <rect x="380" y="460" width="12" height="12" rx="2" fill="#24374a" transform="rotate(10 380 460)" />
    <rect x="30" y="210" width="10" height="10" rx="2" fill="#87b7b7" transform="rotate(30 30 210)" />

    <!-- Code window -->
    <g transform="translate(370, 145)">
      <defs>
        <filter id="text-glow">
          <feGaussianBlur stdDeviation="3" result="blur" />
          <feMerge><feMergeNode in="blur" /><feMergeNode in="SourceGraphic" /></feMerge>
        </filter>
      </defs>
      <rect x="0" y="0" width="280" height="210" rx="12" fill="#253241" />
      <circle cx="20" cy="20" r="4" fill="#66798c" />
      <circle cx="34" cy="20" r="4" fill="#66798c" />
      <circle cx="48" cy="20" r="4" fill="#66798c" />
      <text x="18" y="50" font-family="monospace" font-size="11" fill="#556b78">&#123; <tspan fill="#7a98a6">"basics"</tspan>: &#123;</text>
      <text x="36" y="68" font-family="monospace" font-size="11"><tspan fill="#7a98a6">"givenName"</tspan><tspan fill="#556b78">: </tspan><tspan fill="#d4e0e5" data-json-val="givenName">"Marie"</tspan><tspan fill="#556b78">,</tspan></text>
      <text x="36" y="86" font-family="monospace" font-size="11"><tspan fill="#7a98a6">"familyName"</tspan><tspan fill="#556b78">: </tspan><tspan fill="#d4e0e5" data-json-val="familyName">"Dupont"</tspan><tspan fill="#556b78">,</tspan></text>
      <text x="36" y="104" font-family="monospace" font-size="11"><tspan fill="#7a98a6">"headline"</tspan><tspan fill="#556b78">: </tspan><tspan fill="#d4e0e5" data-json-val="headline">"Engineer"</tspan><tspan fill="#556b78">,</tspan></text>
      <text x="36" y="122" font-family="monospace" font-size="11"><tspan fill="#7a98a6">"email"</tspan><tspan fill="#556b78">: </tspan><tspan fill="#d4e0e5" data-json-val="email">"marie@example.com"</tspan><tspan fill="#556b78">,</tspan></text>
      <text x="36" y="140" font-family="monospace" font-size="11"><tspan fill="#7a98a6">"location"</tspan><tspan fill="#556b78">: &#123;</tspan></text>
      <text x="50" y="158" font-family="monospace" font-size="11"><tspan fill="#7a98a6">"city"</tspan><tspan fill="#556b78">: </tspan><tspan fill="#d4e0e5" data-json-val="city">"Paris"</tspan></text>
      <text x="36" y="176" font-family="monospace" font-size="11" fill="#556b78">&#125;</text>
      <text x="22" y="194" font-family="monospace" font-size="11" fill="#556b78">&#125; &#125;</text>
    </g>

    <!-- VitaeFlow logo document -->
    <g transform="translate(60, 85) scale(0.9)">
      <path
        d="M 123.6,20.1 125.3,264.3 317.8,263.4 316.5,72.3 263,19.2 Z"
        fill="#fcfbf8" />
      <path
        d="M 261.6 12.1 L 120.6 12.4 A 3.5 3.5 0 0 0 117.1 16 L 118.5 101.4 A 0.55 0.55 0 0 0 119.1 101.9 L 129.1 101.9 A 3 3 0 0 0 132.1 98.9 L 131.3 30.7 A 4.9 4.9 0 0 1 136.2 25.7 L 253.5 25.7 A 2.1 2.1 0 0 1 255.5 27.8 L 255.8 75.2 A 2.2 2.2 0 0 0 258 77.4 L 303.7 77.9 A 7.2 7.2 0 0 1 310.9 85.2 L 310.6 249.3 A 7.1 7.1 0 0 1 303.4 256.4 L 133.4 256.4 A 1.2 1.2 0 0 1 132.2 255.2 L 132.2 226.8 A 0.58 0.58 0 0 0 131.6 226.2 L 119.5 226.2 A 1.8 1.8 0 0 0 117.6 228 L 117.9 263.3 A 8.3 8.3 0 0 0 126.2 271.5 L 316.5 271 A 8.1 8.1 0 0 0 324.5 262.9 L 324.8 73.4 A 7.9 7.9 0 0 0 322.5 67.8 L 271.9 16.4 A 14.3 14.3 0 0 0 261.6 12.1 z M 270.4 35.1 C 270.7 35.1 300.6 64.1 300.6 64.4 C 300.6 64.7 270.7 64.4 270.4 64.1 C 270.1 63.8 270.1 35.1 270.4 35.1 z"
        fill="#1b2840" />
      <rect x="165.9" y="104.4" width="126.2" height="8.6" rx="4" fill="#5e8f94" />
      <rect x="165.9" y="130" width="126.2" height="8.6" rx="4" fill="#5e8f94" />
      <rect x="165.9" y="154.3" width="126.2" height="8.6" rx="4" fill="#5e8f94" />
      <g data-cube-chain></g>
    </g>
  </svg>
</div>

<script>
  const SVG_NS = 'http://www.w3.org/2000/svg';

  // Chain positions form the logo's diagonal pixel pattern.
  // Index 0 = head (absorbed first), index N = tail (new cubes spawn here).
  const CHAIN = [
    { x: 214.3, y: 200.8, color: '#5e8f94' },
    { x: 158.4, y: 179.7, color: '#1b2840' },
    { x: 106.5, y: 140.3, color: '#5e8f94' },
    { x: 52.7,  y: 119,   color: '#1b2840' },
    { x: 8.4,   y: 74.8,  color: '#5e8f94' },
    { x: 53.8,  y: 29.6,  color: '#1b2840' },
  ];

  const CUBE_W = 45.4;
  const CUBE_H = 43.6;
  const STEP_MS = 900;
  const PAUSE_MS = 600;
  const COLORS = ['#5e8f94', '#1b2840'];

  // JSON values cycle on each absorption to show the data flowing in
  const JSON_FIELDS = ['givenName', 'familyName', 'headline', 'email', 'city'] as const;
  const JSON_VALUES: Record<string, string[]> = {
    givenName:  ['"Marie"', '"Luca"', '"Yuki"', '"Alex"', '"Sara"'],
    familyName: ['"Dupont"', '"Rossi"', '"Tanaka"', '"Chen"', '"Müller"'],
    headline:   ['"Engineer"', '"Designer"', '"Data Scientist"', '"DevOps"', '"PM"'],
    email:      ['"marie@example.com"', '"luca@example.com"', '"yuki@example.com"', '"alex@example.com"', '"sara@example.com"'],
    city:       ['"Paris"', '"Milan"', '"Tokyo"', '"Toronto"', '"Berlin"'],
  };

  function initChain(container: Element) {
    const svg = container.closest('svg')!;
    let visible = true;

    const observer = new IntersectionObserver(([e]) => { visible = e.isIntersecting; });
    observer.observe(svg);

    const jsonEls = Object.fromEntries(
      JSON_FIELDS.map(f => [f, svg.querySelector(`[data-json-val="${f}"]`) as SVGTSpanElement])
    );
    const jsonIndexes = Object.fromEntries(JSON_FIELDS.map(f => [f, 0])) as Record<string, number>;
    let fieldCursor = 0;
    let colorIdx = 0;

    const cubes: SVGRectElement[] = CHAIN.map((pos) => {
      const r = document.createElementNS(SVG_NS, 'rect');
      r.setAttribute('x', String(pos.x));
      r.setAttribute('y', String(pos.y));
      r.setAttribute('width', String(CUBE_W));
      r.setAttribute('height', String(CUBE_H));
      r.setAttribute('rx', '4');
      r.setAttribute('fill', pos.color);
      container.appendChild(r);
      return r;
    });

    function slideTo(rect: SVGRectElement, toX: number, toY: number): Promise<void> {
      const dx = toX - parseFloat(rect.getAttribute('x')!);
      const dy = toY - parseFloat(rect.getAttribute('y')!);

      return rect.animate([
        { transform: 'translate(0,0)' },
        { transform: `translate(${dx}px,${dy}px)` },
      ], {
        duration: STEP_MS,
        easing: 'cubic-bezier(0.33, 1, 0.68, 1)',
        fill: 'forwards',
      }).finished.then(() => {
        rect.setAttribute('x', String(toX));
        rect.setAttribute('y', String(toY));
        rect.getAnimations().forEach(a => a.cancel());
      });
    }

    async function step() {
      // 1. Absorb head cube (fade toward top-right)
      const head = cubes[0];
      const headAnim = head.animate([
        { opacity: 1, transform: 'translate(0,0) scale(1)' },
        { opacity: 0, transform: 'translate(50px,-50px) scale(0.85)' },
      ], { duration: STEP_MS * 0.6, easing: 'ease-in', fill: 'forwards' });

      // 2. Cycle a JSON value with glow
      const field = JSON_FIELDS[fieldCursor++ % JSON_FIELDS.length];
      const el = jsonEls[field];
      if (el) {
        jsonIndexes[field] = (jsonIndexes[field] + 1) % JSON_VALUES[field].length;
        el.textContent = JSON_VALUES[field][jsonIndexes[field]];
        el.getAnimations().forEach(a => a.cancel());
        el.setAttribute('filter', 'url(#text-glow)');
        const glow = el.animate(
          [{ fill: '#ffffff' }, { fill: '#d4e0e5' }],
          { duration: 600, easing: 'ease-out', fill: 'forwards' },
        );
        glow.finished.then(() => { glow.cancel(); el.removeAttribute('filter'); });
      }

      // 3. Shift remaining cubes forward one position
      const anims: Promise<void>[] = [];
      for (let i = 1; i < cubes.length; i++) {
        anims.push(slideTo(cubes[i], CHAIN[i - 1].x, CHAIN[i - 1].y));
      }

      // 4. Spawn new cube at tail
      const newCube = document.createElementNS(SVG_NS, 'rect');
      const tail = CHAIN[CHAIN.length - 1];
      newCube.setAttribute('x', String(tail.x));
      newCube.setAttribute('y', String(tail.y));
      newCube.setAttribute('width', String(CUBE_W));
      newCube.setAttribute('height', String(CUBE_H));
      newCube.setAttribute('rx', '4');
      newCube.setAttribute('fill', COLORS[colorIdx++ % COLORS.length]);
      container.appendChild(newCube);

      anims.push(
        newCube.animate(
          [{ opacity: 0, transform: 'scale(0.7)' }, { opacity: 1, transform: 'scale(1)' }],
          { duration: STEP_MS * 0.6, easing: 'ease-out', fill: 'forwards' },
        ).finished.then(() => {
          newCube.getAnimations().forEach(a => a.cancel());
          newCube.style.opacity = '1';
        })
      );

      await Promise.all([headAnim.finished, ...anims]);
      headAnim.cancel();
      head.remove();
      cubes.shift();
      cubes.push(newCube);
    }

    async function loop() {
      while (container.isConnected) {
        if (!visible) { await sleep(500); continue; }
        await step();
        await sleep(PAUSE_MS);
      }
      observer.disconnect();
    }

    loop();
  }

  function sleep(ms: number) { return new Promise<void>(r => setTimeout(r, ms)); }

  document.querySelectorAll('[data-cube-chain]').forEach(initChain);
</script>
